APP_NAME=PlayNexis
APP_ENV=development

SUPABASE_URL=https://your-project-ref.supabase.co
# Supported single-key backend setup. Never expose this value to the frontend.
SUPABASE_KEY=your-supabase-server-key
# Optional split-key setup:
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

JWT_SECRET_KEY=change-this-local-secret

# Include http:// or https://. Production example: https://playnexis.in
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000
ARENA_MEDIA_BUCKET=Playnexis

# PLAYNEXIS application-level email verification. Configure these in every
# deployed backend environment before enabling public password signup.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM_EMAIL=no-reply@playnexis.in
SMTP_FROM_NAME=PLAYNEXIS
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400

# Optional. The app can run through Supabase APIs without this.
# Use this only for direct SQLAlchemy/database features if they are enabled later.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
